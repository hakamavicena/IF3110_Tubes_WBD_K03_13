# Konfigurasi Database Platform Internal (PostgreSQL)
INTERNAL_DB_URL=postgres://app:app@localhost:5433/platform?sslmode=disable

# Parameter fallback jika INTERNAL_DB_URL tidak disetel
DB_HOST=localhost
DB_PORT=5433
DB_USER=app
DB_PASSWORD=app
DB_NAME=platform

# Kunci Enkripsi AES-256-GCM untuk Password Database Target (32-byte base64 encoded)
# Buat dengan: openssl rand -base64 32
SECRET_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Server HTTP
LISTEN_ADDR=:8080

# Timeout Eksekusi Migration
MIGRATION_TIMEOUT=30s

# Lingkungan Aplikasi (development / production)
# Menentukan apakah cookie disetel Secure=true (hanya di production)
APP_ENV=development

# Parameter Konfigurasi Session & Rotasi
SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT=12h
SESSION_ROTATION_INTERVAL=15m
SESSION_GRACE_PERIOD=30s

